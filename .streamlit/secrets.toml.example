# Local use: copy this file to .streamlit/secrets.toml (that file is git-ignored; never commit a real key).
# Streamlit Community Cloud: paste the same lines into App settings > Secrets.
# Free key: https://aistudio.google.com/apikey

GEMINI_API_KEY = "paste-your-gemini-api-key-here"

# Optional: use a different Gemini model without touching the code.
# GEMINI_MODEL = "gemini-3.5-flash-lite"
